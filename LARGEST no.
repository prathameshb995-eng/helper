program code : LARGEST NUMBER 	

ASSUME CS:CODE , DS:DATA
CODE SEGMENT
START MOV AX, DATA
      MOV DS, AX
      MOV AX, 0000H
      MOV SI, 0000H
      MOV CL, 04H 
      MOV AL, [SI]

UP: INC SI
    MOV BL, [SI]
    CMP AL, BL
    JNC DOWN
    XCHG AL, BL

DOWN: DEC CL
      JNZ UP
      MOV [SI+1], AL

CODE ENDS
DATA SEGMENT 
NUM DB 01,02,05,03,04
DATA ENDS 
END

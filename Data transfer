ASSUME CS:CODE, DS:DATA

CODE SEGMENT
START:
    MOV AX, DATA
    MOV DS, AX

    MOV AX, 0000H
    MOV SI, 0000H
    MOV DI, 1200H
    MOV CL, 05H

UP:
    MOV AL, [SI]
    MOV [DI], AL
    INC SI
    INC DI
    DEC CL
    JNZ UP

CODE ENDS

DATA SEGMENT
NUM DB 01H, 02H, 03H, 04H, 05H
DATA ENDS

END START
